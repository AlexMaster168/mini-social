# Server
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:alexalex@localhost:5432/mini_social
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Comma-separated list, only needed if the web app is served from another origin
CORS_ORIGIN=
LOG_LEVEL=info

# Production only
# COOKIE_SECURE=true
# TRUST_PROXY=false
